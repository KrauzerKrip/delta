@using Sandbox
@using Sandbox.UI
@namespace Sandbox
@inherits PanelComponent

<root class="@(Minigame?.IsDialogueVisible == true ? "visible" : "")">
	@if ( Minigame?.IsDialogueVisible == true )
	{
		<div class="dialogue-box">
			<div class="speaker">Marie</div>
			<div class="line">@Minigame.CurrentDialogueLine</div>
			<div class="controls-hint">
				<div class="control"><span class="key">WASD</span> Move</div>
				<div class="control"><span class="key">Q</span><span class="key">E</span> Rotate</div>
				<div class="control"><span class="key wide">Shift</span> Hold breath</div>
			</div>
		</div>
	}
</root>

@code
{
	public PliersMinigameController Minigame { get; set; }

	protected override int BuildHash() => System.HashCode.Combine(
		Minigame?.IsDialogueVisible,
		Minigame?.CurrentDialogueLine );
}
