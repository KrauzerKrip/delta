@using Sandbox
@using Sandbox.UI
@namespace Sandbox
@inherits PanelComponent

<root>
	<div class="dollhouse-cursor @RangeClass @(pressed ? "pressed" : "")" style="@CursorStyle">
		<div class="target-ring"></div>
		<div class="target-dot"></div>
		<div class="direction-tick"></div>
	</div>
</root>

@code
{
	private Vector2 cursorPosition;
	private bool pressed;
	private bool isInRange;

	public InteractionController Interaction { get; set; }

	private string CursorStyle =>
		$"left: {cursorPosition.x}px; top: {cursorPosition.y}px;";
	private string RangeClass => isInRange ? "in-range" : "out-of-range";

	protected override void OnStart()
	{
		Mouse.Visibility = MouseVisibility.Visible;
	}

	protected override void OnUpdate()
	{
		if ( Panel is not null )
			cursorPosition = Panel.MousePosition * Panel.ScaleFromScreen;

		pressed = Input.Down( "Attack1" );
		isInRange = IsCursorInInteractionRange();
	}

	private bool IsCursorInInteractionRange()
	{
		if ( Interaction is null || Scene.Camera is null )
			return false;

		var cursorRay = Scene.Camera.ScreenPixelToRay( Mouse.Position );
		var trace = Scene.Trace
			.Ray( cursorRay, 100000f )
			.IgnoreGameObjectHierarchy( Interaction.GameObject )
			.Run();

		if ( !trace.Hit )
			return false;

		var distanceFromPlayer = (trace.HitPosition - Interaction.WorldPosition).Length;
		return distanceFromPlayer <= Interaction.InteractionDistance;
	}

	protected override void OnDisabled()
	{
		Mouse.Visibility = MouseVisibility.Auto;
	}

	protected override int BuildHash() => System.HashCode.Combine( cursorPosition, pressed, isInRange );
}
